# --- Application ---
APP_ENV=development            # development | production
SECRET_KEY=change-me-long-random-string
JWT_SECRET_KEY=change-me-another-long-random-string
APP_BASE_URL=http://localhost:5000   # liens des emails. Sur Vercel : https://votre-projet.vercel.app (ou votre domaine)

# --- Base de données ---
# En dev, sans DATABASE_URL, SQLite est utilisé (instance/garage_dev.db).
# Production : adresse "pooled" de Neon, ex. postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Email ---
# Production (Vercel) : API HTTPS Brevo (clé "API", pas la clé SMTP). Prioritaire sur le SMTP.
BREVO_API_KEY=
# Alternative / développement : SMTP. Sans BREVO_API_KEY ni MAIL_SERVER, les emails sont affichés dans la console.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
# Adresse d'expéditeur vérifiée chez Brevo :
MAIL_DEFAULT_SENDER=Garage SaaS <no-reply@example.com>

# --- Logos (Cloudinary). Obligatoire en production. Vide en dev = stockage local ---
CLOUDINARY_URL=

# --- Paramètres par défaut des nouveaux garages ---
DEFAULT_CURRENCY=XOF
DEFAULT_CURRENCY_DECIMALS=0
TRIAL_DAYS=30

# --- Sécurité ---
CORS_ORIGINS=                   # vide = même origine uniquement
RATELIMIT_STORAGE_URI=memory://  # production : rediss://... (Upstash), sinon la limite est par instance
CRON_SECRET=                    # long secret aléatoire ; Vercel l'envoie au cron de purge des jetons

# --- Confirmation de l'email à l'inscription (désactivée par défaut) ---
REQUIRE_EMAIL_VERIFICATION=false

# --- Devis ---
DEVIS_VALIDITE_JOURS=30   # validité proposée à l'envoi d'un devis
FACTURE_ECHEANCE_JOURS=30   # délai de paiement proposé à l'émission d'une facture
