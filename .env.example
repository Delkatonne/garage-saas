# --- Application ---
APP_ENV=development            # development | production
SECRET_KEY=change-me-long-random-string
JWT_SECRET_KEY=change-me-another-long-random-string
APP_BASE_URL=http://localhost:5000   # utilisé dans les liens des emails

# --- Base de données ---
DATABASE_URL=postgresql://user:password@localhost:5432/garage_saas
# (en dev, sans DATABASE_URL, SQLite est utilisé : instance/garage_dev.db)

# --- Email (SMTP : Brevo, Gmail avec mot de passe d'application, Mailgun...) ---
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=Garage SaaS <no-reply@example.com>

# --- Logos (Cloudinary). Vide = stockage local (dev uniquement) ---
CLOUDINARY_URL=

# --- Paramètres par défaut des nouveaux garages ---
DEFAULT_CURRENCY=XOF
DEFAULT_CURRENCY_DECIMALS=0
TRIAL_DAYS=30

# --- Sécurité ---
CORS_ORIGINS=                   # vide = même origine uniquement
RATELIMIT_STORAGE_URI=memory://  # en prod multi-workers : redis://...
